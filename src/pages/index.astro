---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/Hero.astro';
import PostCard from '@/components/PostCard.astro';
import { postUrl } from '@/utils/helper';

const posts = (await getCollection('blogs', ({ data }) => data.published))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);
---

<BaseLayout title="Home" description="Welcome To Joshua's Blog Site. Read all about technology, web development, and more!">
  <main class="container max-w-5xl mx-auto text-zinc-600 px-4 sm:px-6 lg:px-8">
    <Hero />

    <section>
      <div class="flex flex-row items-center space-x-3 pt-6 sm:pt-8 pb-4 sm:pb-6">
        <h2 class="text-2xl sm:text-3xl lg:text-4xl font-semibold text-black dark:text-slate-100">Posts</h2>
      </div>
      <div class="grid grid-cols-1 gap-4 sm:gap-6">
        {posts.map((post) => (
          <PostCard
            href={postUrl(post.id)}
            title={post.data.title}
            date={post.data.date}
            description={post.data.description}
            image={post.data.image}
            alt={post.data.alt}
            tags={post.data.tags}
          />
        ))}
      </div>
    </section>
  </main>
</BaseLayout>
