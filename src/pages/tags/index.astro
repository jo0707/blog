---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { tagSlug } from '@/utils/helper';

const posts = await getCollection('blogs', ({ data }) => data.published);

const tagMap = new Map<string, { name: string; count: number }>();
for (const post of posts) {
  for (const tag of post.data.tags) {
    const slug = tagSlug(tag);
    const entry = tagMap.get(slug);
    if (entry) {
      entry.count += 1;
    } else {
      tagMap.set(slug, { name: tag, count: 1 });
    }
  }
}

const tags = [...tagMap.entries()].sort((a, b) => b[1].count - a[1].count || a[0].localeCompare(b[0]));
---

<BaseLayout title="Tags" description="Browse every blog post by tag or category.">
  <main class="container max-w-5xl mx-auto text-zinc-600 px-4 sm:px-6 lg:px-8">
    <section class="py-12 sm:py-16">
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold text-black dark:text-slate-100">Tags</h1>
      <p class="mt-4 max-w-2xl text-gray-700 dark:text-slate-300">All topics covered on this blog.</p>
    </section>

    <section class="flex flex-wrap gap-2 sm:gap-3">
      {tags.map(([slug, entry]) => (
        <a
          href={`/tags/${slug}`}
          class="group inline-flex items-center gap-2 rounded px-4 py-2 text-sm font-semibold bg-gray-100 dark:bg-slate-800 text-gray-800 dark:text-slate-100 transition-colors hover:bg-gray-900 hover:text-white dark:hover:bg-slate-100 dark:hover:text-slate-900"
        >
          {entry.name}
          <span class="rounded bg-white/70 dark:bg-slate-900/60 px-1.5 py-0.5 text-xs text-gray-600 group-hover:bg-white/20 dark:group-hover:text-slate-200">
            {entry.count}
          </span>
        </a>
      ))}
    </section>
  </main>
</BaseLayout>
