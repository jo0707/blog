---
import { formatDate } from '@/utils/helper';

interface Props {
  href: string;
  title: string;
  date: Date | string;
  description: string;
  image: string;
  alt: string;
  tags: string[];
}

const { href, title, date, description, image, alt, tags } = Astro.props;
---

<article class="md:h-48 group rounded-sm overflow-hidden shadow-sm hover:shadow-md transition-shadow duration-300 border border-gray-200 dark:border-gray-800 bg-white dark:bg-slate-900">
  <a href={href} class="grid grid-cols-1 md:grid-cols-10 gap-0 md:gap-1 min-h-[200px] md:h-40">
    <div class="md:col-span-3 h-36 md:h-full">
      <img class="h-full w-full object-cover" width="300" height="160" src={image} alt={alt} loading="lazy" decoding="async" />
    </div>

    <div class="md:col-span-7 p-4 sm:p-5 flex flex-col justify-between">
      <div>
        <h2 class="line-clamp-1 text-ellipsis text-lg sm:text-xl font-semibold text-black dark:text-slate-100 group-hover:text-gray-600 dark:group-hover:text-slate-400 leading-tight">
          {title}
        </h2>
        <p class="mt-1 text-ellipsis line-clamp-1 text-sm sm:text-base text-gray-700 dark:text-slate-300 group-hover:text-gray-500 dark:group-hover:text-slate-400">
          {description}
        </p>

        <div class="mt-3 flex items-center gap-1 flex-wrap">
          {tags.slice(0, 3).map((tag) => (
            <span class="text-xs bg-gray-200 dark:bg-slate-800 text-gray-800 dark:text-slate-200 rounded px-2 py-1 font-semibold">
              {tag}
            </span>
          ))}
          {tags.length > 3 && <span class="text-xs text-gray-500 dark:text-slate-400">+{tags.length - 3} more</span>}
        </div>
      </div>

      <div class="flex flex-row justify-between items-center pt-2 max-md:mt-4">
        <span class="text-black dark:text-slate-100 group-hover:underline text-sm sm:text-base font-medium">Read More</span>
        <time class="text-gray-600 dark:text-slate-400 text-xs sm:text-sm" datetime={new Date(date).toISOString()}>
          {formatDate(date)}
        </time>
      </div>
    </div>
  </a>
</article>
