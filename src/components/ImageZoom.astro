---
// Click-to-zoom lightbox for images inside post content (.prose img).
// Adds a zoom-in cursor and opens a fullscreen overlay on click.
// Runs once on page load (no view transitions).
---

<div id="image-zoom" class="image-zoom hidden" role="dialog" aria-modal="true" aria-label="Image preview">
  <button id="image-zoom-close" class="image-zoom__close" type="button" aria-label="Close image preview">
    ✕
  </button>
  <img id="image-zoom-img" class="image-zoom__img" alt="" />
</div>

<script is:inline>
  (() => {
    const overlay = document.getElementById('image-zoom');
    const zoomImg = document.getElementById('image-zoom-img');
    const closeBtn = document.getElementById('image-zoom-close');

    const openZoom = (img) => {
      if (!overlay || !zoomImg) return;
      zoomImg.src = img.currentSrc || img.src;
      zoomImg.alt = img.alt || '';
      overlay.classList.remove('hidden');
      document.body.classList.add('overflow-hidden');
      closeBtn?.focus();
    };

    const closeZoom = () => {
      if (!overlay) return;
      overlay.classList.add('hidden');
      document.body.classList.remove('overflow-hidden');
    };

    const enhance = () => {
      document.querySelectorAll('.prose img, img.zoomable').forEach((img) => {
        if (img.dataset.zoomEnhanced === 'true') return;
        img.dataset.zoomEnhanced = 'true';
        img.classList.add('zoomable');
        img.addEventListener('click', () => openZoom(img));
      });
    };

    overlay?.addEventListener('click', (event) => {
      if (event.target === overlay || event.target === zoomImg) closeZoom();
    });
    closeBtn?.addEventListener('click', closeZoom);
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') closeZoom();
    });

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', enhance, { once: true });
    } else {
      enhance();
    }
  })();
</script>

<style is:global>
  img.zoomable {
    cursor: zoom-in;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  img.zoomable:hover {
    box-shadow: 0 8px 16px -2px rgb(0 0 0 / 0.12), 0 14px 32px -8px rgb(0 0 0 / 0.22);
  }

  .image-zoom {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    background: rgb(0 0 0 / 0.85);
    backdrop-filter: blur(4px);
    cursor: zoom-out;
  }

  .image-zoom.hidden {
    display: none;
  }

  .image-zoom__img {
    max-width: 100%;
    max-height: 90vh;
    border-radius: 0.5rem;
    border: 1px solid rgb(255 255 255 / 0.3);
    box-shadow: 0 20px 60px -15px rgb(0 0 0 / 0.7);
    cursor: zoom-out;
  }

  .image-zoom__close {
    position: absolute;
    top: 1rem;
    right: 1rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 9999px;
    border: 1px solid rgb(255 255 255 / 0.25);
    background: rgb(255 255 255 / 0.1);
    color: #fff;
    font-size: 1rem;
    line-height: 1;
    cursor: pointer;
    transition: background-color 0.15s ease;
  }

  .image-zoom__close:hover {
    background: rgb(255 255 255 / 0.25);
  }
</style>
